# ---- Required --------------------------------------------------------------

# postgresql+psycopg2://<user>:<password>@localhost:5432/secure_pay
DATABASE_URL=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Owner-only key for the bank simulator routes (/bank/*, /cards/issuance, /admin/*).
# Send it as the X-Admin-Key header. Never put it in the frontend.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# ---- Optional (defaults shown) --------------------------------------------

# REDIS_URL=redis://localhost:6379/0
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=7
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to false on a public deployment to remove the admin routes entirely.
# ENABLE_ADMIN_ROUTES=true

# Logging: "text" is easy to read locally, "json" suits log collectors.
# The Docker image defaults to json. LOG_TO_FILE also writes logs/app.log.
# LOG_FORMAT=text
# LOG_TO_FILE=false
# LOG_LEVEL=INFO

# Docker image only: number of API worker processes (default 2).
# WEB_CONCURRENCY=2
